{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-13",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "cuda",
      "hidden": true,
      "cacheVariables": {
        "PTE_ENABLE_CUDA": "ON",
        "CMAKE_CUDA_COMPILER": "/usr/local/cuda/bin/nvcc",
        "CMAKE_CUDA_HOST_COMPILER": "/usr/bin/g++-13",
        "CMAKE_CUDA_ARCHITECTURES": "89"
      }
    },
    {
      "name": "dev",
      "displayName": "Dev (RelWithDebInfo, CUDA, tests)",
      "inherits": ["base", "cuda"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "debug",
      "displayName": "Debug (CUDA, tests, -G device debug)",
      "inherits": ["base", "cuda"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (CUDA, tests)",
      "inherits": ["base", "cuda"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "cpu-only",
      "displayName": "CPU only (no CUDA toolkit needed)",
      "inherits": ["base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "PTE_ENABLE_CUDA": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "cpu-only", "configurePreset": "cpu-only" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "cpu-only",
      "configurePreset": "cpu-only",
      "output": { "outputOnFailure": true }
    }
  ]
}
