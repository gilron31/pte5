LIB "primdec.lib"; LIB "elim.lib";
ring r = 0, (t,u), dp;
poly L1 = t^2 + u^2 + 6;
ideal I = 4032*t^4 - 24704*t^2*u^2 + 15616*t^2 + 4032*u^4 + 15616*u^2 - 18688, -1294848*t^8 - 5179392*t^6*u^2 + 237359104*t^6 - 7769088*t^4*u^4 - 361664512*t^4*u^2 - 2427170816*t^4 - 5179392*t^2*u^6 - 361664512*t^2*u^4 + 3735592960*t^2*u^2 + 3176218624*t^2 - 1294848*u^8 + 237359104*u^6 - 2427170816*u^4 + 3176218624*u^2 - 1678123008;
def S0 = sat(I, ideal(L1));
ideal S; if (typeof(S0) == "list") { S = S0[1]; } else { S = S0; }
S = std(S);
"fiber dim:"; dim(S);
"fiber points with multiplicity:"; vdim(S);
list L = minAssGTZ(S);
"Q-components:"; size(L);
int i;
for (i = 1; i <= size(L); i++) { ideal Pi = std(L[i]); print("  deg " + string(vdim(Pi)) + "  mult " + string(vdim(std(L[i]^1)))); }
"reduced total:"; vdim(std(radical(S)));
quit;
