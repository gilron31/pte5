LIB "primdec.lib";
ring r = 0, (t,u), dp;
poly L1 = t^2 + u^2 + 6;
ideal I = -25*t^6 - 12*t^5*u^2 + 70*t^5*u + 28*t^4*u^3 + 29*t^4*u^2 - 40*t^4*u - 400*t^4 + 28*t^3*u^4 - 68*t^3*u^3 - 120*t^3*u^2 - 200*t^3*u + 500*t^3 - 12*t^2*u^5 + 29*t^2*u^4 - 120*t^2*u^3 + 800*t^2*u^2 - 100*t^2*u + 500*t^2 + 70*t*u^5 - 40*t*u^4 - 200*t*u^3 - 100*t*u^2 - 3000*t*u - 25*u^6 - 400*u^4 + 500*u^3 + 500*u^2 + 10000, -6629711732628135534550818*t^4 + 45202079541817294923626564*t^2*u^2 - 21095037784464060421881616*t^2 - 6629711732628135534550818*u^4 - 21095037784464060421881616*u^2 + 53637892660754950719811552, 118445672466276582131303281188383285176352145408*t^8 + 473782689865106328525213124753533140705408581632*t^6*u^2 - 31334777199270078019440627459705610011520339262608*t^6 + 710674034797659492787819687130299711058112872448*t^4*u^4 + 42705561756032629904045742453790405388450145221776*t^4*u^2 + 299004051960401469665096758402505260444114389427328*t^4 + 473782689865106328525213124753533140705408581632*t^2*u^6 + 42705561756032629904045742453790405388450145221776*t^2*u^4 - 495671042909939972368747481858247362495860525222144*t^2*u^2 - 444502512404508488888024464384865783299676398405888*t^2 + 118445672466276582131303281188383285176352145408*u^8 - 31334777199270078019440627459705610011520339262608*u^6 + 299004051960401469665096758402505260444114389427328*u^4 - 444502512404508488888024464384865783299676398405888*u^2 + 153505591516294450442169052420144737588552380448768;
def S0 = sat(I, ideal(L1));
ideal S; if (typeof(S0) == "list") { S = S0[1]; } else { S = S0; }
S = std(S);
"LEN"; vdim(S);
list L = minAssGTZ(S);
int i; for (i = 1; i <= size(L); i++) { ideal P = std(L[i]); if (vdim(P) == 1) { "PT"; P[1]; P[2]; } else { "CLUSTER"; vdim(P); } }
quit;
