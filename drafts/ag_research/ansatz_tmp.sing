ring r = 0, (x,y,z), dp;
short = 0;
list L; poly R;
R = -2*x^4*y - x^4*z + 14*x^3*y^2 - 2*x^3*y*z - 28*x^3*z^2 - 12*x^2*y^3 - 48*x^2*y^2*z + 106*x^2*y*z^2 - 117*x^2*z^3 + 26*x*y^3*z + 110*x*y^2*z^2 - 94*x*y*z^3 - 176*x*z^4 - 4*y^3*z^2 - 19*y^2*z^3 - 104*y*z^4 - 81*z^5; L = factorize(R); print("F0"); int j; for (j = 1; j <= size(L[1]); j++) { if (deg(L[1][j]) == 3) { print(L[1][j]); } } kill j;
R = -2*x^4*y - x^4*z - 8*x^3*y^2 - 24*x^3*y*z - 28*x^3*z^2 + 32*x^2*y^3 + 15*x^2*y^2*z - 128*x^2*y*z^2 - 117*x^2*z^3 - 22*x*y^4 + 106*x*y^3*z + 348*x*y^2*z^2 + 68*x*y*z^3 - 176*x*z^4 - 121*y^4*z - 158*y^3*z^2 + 194*y^2*z^3 + 166*y*z^4 - 81*z^5; L = factorize(R); print("F1"); int j; for (j = 1; j <= size(L[1]); j++) { if (deg(L[1][j]) == 3) { print(L[1][j]); } } kill j;
R = -24*x^4*y - 144*x^4*z + 36*x^3*y^2 + 160*x^3*y*z + 68*x^3*z^2 + 10*x^2*y^3 + 216*x^2*y^2*z + 110*x^2*y*z^2 - 180*x^2*z^3 - 22*x*y^4 - 136*x*y^3*z - 136*x*y^2*z^2 + 56*x*y*z^3 + 94*x*z^4 - 121*y^4*z - 158*y^3*z^2 + 194*y^2*z^3 + 166*y*z^4 - 81*z^5; L = factorize(R); print("F2"); int j; for (j = 1; j <= size(L[1]); j++) { if (deg(L[1][j]) == 3) { print(L[1][j]); } } kill j;
R = -2*x^4*y - x^4*z + 14*x^3*y^2 - 2*x^3*y*z - 28*x^3*z^2 - 12*x^2*y^3 - 48*x^2*y^2*z + 106*x^2*y*z^2 - 117*x^2*z^3 + 26*x*y^3*z + 110*x*y^2*z^2 - 94*x*y*z^3 - 176*x*z^4 - 4*y^3*z^2 - 19*y^2*z^3 - 104*y*z^4 - 81*z^5; L = factorize(R); print("F3"); int j; for (j = 1; j <= size(L[1]); j++) { if (deg(L[1][j]) == 3) { print(L[1][j]); } } kill j;
R = -2*x^4*y - x^4*z - 8*x^3*y^2 - 24*x^3*y*z - 28*x^3*z^2 + 32*x^2*y^3 + 15*x^2*y^2*z - 128*x^2*y*z^2 - 117*x^2*z^3 - 22*x*y^4 + 106*x*y^3*z + 348*x*y^2*z^2 + 68*x*y*z^3 - 176*x*z^4 - 121*y^4*z - 158*y^3*z^2 + 194*y^2*z^3 + 166*y*z^4 - 81*z^5; L = factorize(R); print("F4"); int j; for (j = 1; j <= size(L[1]); j++) { if (deg(L[1][j]) == 3) { print(L[1][j]); } } kill j;
R = -24*x^4*y - 144*x^4*z + 36*x^3*y^2 + 160*x^3*y*z + 68*x^3*z^2 + 10*x^2*y^3 + 216*x^2*y^2*z + 110*x^2*y*z^2 - 180*x^2*z^3 - 22*x*y^4 - 136*x*y^3*z - 136*x*y^2*z^2 + 56*x*y*z^3 + 94*x*z^4 - 121*y^4*z - 158*y^3*z^2 + 194*y^2*z^3 + 166*y*z^4 - 81*z^5; L = factorize(R); print("F5"); int j; for (j = 1; j <= size(L[1]); j++) { if (deg(L[1][j]) == 3) { print(L[1][j]); } } kill j;
quit;